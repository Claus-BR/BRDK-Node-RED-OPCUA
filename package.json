{
  "name": "@brdk/node-red-opcua",
  "version": "1.0.2",
  "description": "A modern, clean Node-RED OPC UA client library for interacting with OPC UA servers",
  "license": "Apache-2.0",
  "author": "Clausbr",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BRDK-Public/brdk-node-red-opcua.git"
  },
  "keywords": [
    "node-red",
    "opcua",
    "opc-ua",
    "industrial",
    "automation",
    "iot"
  ],
  "engines": {
    "node": ">=18"
  },
  "node-red": {
    "version": ">=2.0.0",
    "nodes": {
      "opcua-endpoint": "src/nodes/opcua-endpoint.js",
      "opcua-subscription": "src/nodes/opcua-subscription.js",
      "opcua-item": "src/nodes/opcua-item.js",
      "opcua-smart-item": "src/nodes/opcua-smart-item.js",
      "opcua-action": "src/nodes/opcua-action.js",
      "opcua-client": "src/nodes/opcua-client.js",
      "opcua-discovery": "src/nodes/opcua-discovery.js",
      "opcua-rights": "src/nodes/opcua-rights.js",
      "opcua-server": "src/nodes/opcua-server.js",
      "opcua-command": "src/nodes/opcua-command.js"
    }
  },
  "dependencies": {
    "env-paths": "2.2.1",
    "node-opcua": "^2.160.0",
    "node-opcua-client-crawler": "^2.127.1",
    "node-opcua-file-transfer": "^2.160.0"
  },
  "scripts": {
    "prepare": "lefthook install",
    "format": "prettier --write \"**/*.{js,html}\"",
    "format:check": "prettier --check \" **/*.{js,html}\"",
    "lint": "eslint **/*.js",
    "lint:fix": "eslint **/*.js --fix"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.5.0",
    "globals": "^17.7.0",
    "lefthook": "^2.1.9",
    "mocha": "^11.7.5",
    "node-red-node-test-helper": "^0.3.6",
    "prettier": "^3.8.4",
    "should": "^13.2.3"
  }
}
